# Copy to .env and adjust. Every value has a working default.

# Any OpenAI-compatible local server. Ollama by default.
# LM Studio: http://localhost:1234/v1
# llama.cpp: http://localhost:8080/v1
GERMAN_BOT_BASE_URL=http://localhost:11434/v1

# Model tag as the server knows it (check with: ollama list)
GERMAN_BOT_MODEL=qwen3.8:27b

# Starting difficulty: A1, A2 or B1
GERMAN_BOT_LEVEL=A1

# Ignored by local servers, but the OpenAI client requires a non-empty value.
GERMAN_BOT_API_KEY=local

# Voice input. GERMAN_BOT_VOICE=1 is the same as starting with --voice.
# GERMAN_BOT_VOICE=1

# Whisper size: tiny | base | small | medium. Small is the sweet spot for German.
GERMAN_BOT_STT_MODEL=small

# int8 on CPU; use float32 if int8 is unsupported on your machine.
GERMAN_BOT_STT_COMPUTE=int8

# Words the recogniser is less sure about than this get flagged as "unklar".
GERMAN_BOT_STT_CONFIDENCE=0.55

# Seconds of silence that end a recording, and the cap for one take.
GERMAN_BOT_STT_SILENCE=1.8
GERMAN_BOT_STT_MAX_SECONDS=20
