# Copy to .env and adjust. Every value has a working default.

# Any OpenAI-compatible local server. Ollama by default.
# LM Studio: http://localhost:1234/v1
# llama.cpp: http://localhost:8080/v1
GERMAN_BOT_BASE_URL=http://localhost:11434/v1

# Model tag as the server knows it (check with: ollama list)
GERMAN_BOT_MODEL=qwen3.8:27b

# Starting difficulty: A1, A2 or B1
GERMAN_BOT_LEVEL=A1

# Ignored by local servers, but the OpenAI client requires a non-empty value.
GERMAN_BOT_API_KEY=local
